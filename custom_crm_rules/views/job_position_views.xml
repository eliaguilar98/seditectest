<odoo>
    <!-- Vista de Lista para el Catálogo -->
    <record id="view_partner_job_position_tree" model="ir.ui.view">
        <attribute name="name">res.partner.job.position.list</attribute>
        <attribute name="model">res.partner.job.position</attribute>
        <attribute name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </attribute>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_partner_job_position" model="ir.actions.act_window">
        <attribute name="name">Puestos de Trabajo </attribute>
        <attribute name="res_model">res.partner.job.position</attribute>
        <attribute name="view_mode">list,form</attribute>
        <attribute name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer puesto de trabajo para tus contactos.
            </p>
        </attribute>
    </record>

    <!-- Menú dentro de CRM > Configuración -->
    <menuitem id="menu_partner_job_position"
              name="Puestos de Trabajo"
              action="action_partner_job_position"
              parent="crm.crm_menu_config"
              sequence="25"/>
</odoo>