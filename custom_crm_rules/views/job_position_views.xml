<odoo>
    <data>
        <!-- Vista de Lista para el Catálogo -->
        <record id="view_partner_job_position_tree" model="ir.ui.view">
            <field name="name">res.partner.job.position.list</field>
            <field name="model">res.partner.job.position</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Acción de Ventana -->
        <record id="action_partner_job_position" model="ir.actions.act_window">
            <field name="name">Puestos de Trabajo </field>
            <field name="res_model">res.partner.job.position</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea el primer puesto de trabajo para tus contactos.
                </p>
            </field>
        </record>

        <!-- Menú dentro de CRM > Configuración -->
        <menuitem id="menu_partner_job_position"
              name="Puestos de Trabajo"
              action="action_partner_job_position"
              parent="crm.crm_menu_config"
              sequence="25"/>
    </data>
</odoo>