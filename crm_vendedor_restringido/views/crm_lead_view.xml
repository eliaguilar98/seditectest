<odoo>
  <data>
    <record id="crm_lead_form_view_inherit_user_id_readonly" model="ir.ui.view">
        <field name="name">crm.lead.form.view.inherit.user_id.readonly</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!--Reemplaza el campo editable solo para gerencia -->
            <xpath expr="//field[@name='user_id']" position="replace">
                <field name="user_id"
                  attrs="{'readonly': [('can_edit_user_id','=',False)]}"
                  groups="sales_team.group_sale_salesman, sales_team.group_sale_manager"/>
                <!--field name="user_id"
                    groups="sales_team.group_sale_salesman,sales_team.group_sale_manager"
                    modifiers='{"readonly": true}'/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="user_id"
                     groups="sales_team.group_sale_manager"
                     modifiers='{}'/-->
            </xpath>
        </field>
    </record>
  </data>
</odoo>
