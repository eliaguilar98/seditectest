<odoo>
  <data>
    <record id="view_res_partner_form_inherit_user_id_readonly" model="ir.ui.view">
      <field name="name">res.partner.form.inherit.user_id.readonly.attrs</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="arch" type="xml">

        <!-- Modificamos el campo user_id para que solo sea editable por el grupo de Gerentes de Ventas -->
        <xpath expr="//page[@string='Sales &amp; Purchase']//field[@name='user_id']" position="replace">
          <field name="user_id"
                 groups="sales_team.group_sale_salesman,sales_team.group_sale_manager"
                 attrs="{'readonly': [('user_groups_ids', 'not in', [ref('sales_team.group_sale_manager')])]}"/>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
